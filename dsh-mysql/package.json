{
  "name": "@wzxm/dsh-mysql",
  "description": "Authorized MySQL MCP bundle for DeepSeek Harness",
  "version": "0.2.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wzxm/dsh-plugins.git",
    "directory": "dsh-mysql"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-mcp-client": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-settings": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-tools": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-user-approval": "^0.1.5-alpha.1"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-mcp-client": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-settings": "0.1.5-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-user-approval": "^0.1.5-alpha.1",
    "@deepseek-ai/schemastery": "^3.18.2",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
