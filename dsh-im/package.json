{
  "name": "@wzxm/dsh-im",
  "description": "Feishu/Lark IM adapter for DeepSeek Harness",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./transport": {
      "types": "./lib/transport.d.ts",
      "default": "./lib/transport.js"
    },
    "./transport-memory": {
      "types": "./lib/transport-memory.d.ts",
      "default": "./lib/transport-memory.js"
    },
    "./transport-feishu": {
      "types": "./lib/transport-feishu.d.ts",
      "default": "./lib/transport-feishu.js"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wzxm/dsh-plugins.git",
    "directory": "dsh-im"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "lib",
    "README.md",
    "README.zh.md",
    "cordis.patch.yml"
  ],
  "keywords": [
    "deepseek-harness",
    "cordis",
    "plugin",
    "feishu",
    "lark",
    "im"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2",
    "@larksuiteoapi/node-sdk": "1.74.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-agent-default-model": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-agent-presets": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-brand": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-credentials": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-llm": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-permission-presets": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-session": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-session-title": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-webhook": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-workspace": "^0.1.5-alpha.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-agent-default-model": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-agent-presets": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-brand": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-credentials": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-llm": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-permission-presets": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-session": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-session-title": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-webhook": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-workspace": "^0.1.5-alpha.1",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@types/node": "^22.20.2",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
